## GET HERE (https://supabase.com/)
NEXT_PUBLIC_SUPABASE_URL=
NEXT_PUBLIC_SUPABASE_ANON_KEY=
SUPABASE_SERVICE_ROLE_KEY=

# Pinata IPFS (for token logo uploads) - GET HERE (https://pinata.cloud/)
PINATA_API_KEY=
PINATA_API_SECRET=

# WalletConnect Project ID - GET HERE (https://docs.reown.com/cloud/relay)
NEXT_PUBLIC_WALLETCONNECT_PROJECT_ID=

# Native currency USD price — controls all USD displays across the app
# e.g. 1 means 1 ETH = $1, change to 3000 for $3000/ETH
NEXT_PUBLIC_NATIVE_USD_PRICE_LOCALHOST=1

# Token creation fee — must match what the TokenFactory contract was deployed with
# Format: ETH amount as a string e.g. "0.5" for 0.5 ETH
NEXT_PUBLIC_TOKEN_CREATION_FEE_ETH=0.5

# Wallet that receives the token creation fee (display only, contract controls actual receiver)
NEXT_PUBLIC_TOKEN_CREATION_FEE_RECEIVER=

# Network details
NEXT_PUBLIC_NETWORK_NAME=Localhost
NEXT_PUBLIC_NETWORK_SHORT_NAME=LOCAL
NEXT_PUBLIC_RPC_URL=http://127.0.0.1:8545
NEXT_PUBLIC_EXPLORER_URL=http://localhost:8545
NEXT_PUBLIC_NETWORK_LOGO_URL=/tokens/eth.svg

# Native currency
NEXT_PUBLIC_NATIVE_CURRENCY_NAME=Ether
NEXT_PUBLIC_NATIVE_CURRENCY_SYMBOL=ETH
NEXT_PUBLIC_NATIVE_CURRENCY_DECIMALS=18

# Contract addresses
NEXT_PUBLIC_FACTORY_LOCALHOST=
NEXT_PUBLIC_ROUTER_LOCALHOST=
NEXT_PUBLIC_TOKEN_FACTORY_LOCALHOST=
NEXT_PUBLIC_WETH_LOCALHOST=


